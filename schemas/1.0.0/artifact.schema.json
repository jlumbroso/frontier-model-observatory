{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fmo:schema:1.0.0:artifact",
  "allOf": [
    {"$ref": "urn:fmo:schema:1.0.0:common#/$defs/recordEnvelope"},
    {
      "type": "object",
      "required": ["record_type", "preferred_title", "publisher_org_ids", "artifact_class", "native_artifact_type", "subject_refs", "observed_time", "officiality", "corpus_partition", "redistribution_status"],
      "properties": {
        "record_type": {"const": "artifact"},
        "id": {"pattern": "^fmo:artifact:"},
        "preferred_title": {"type": "string", "minLength": 1},
        "alternative_titles": {"type": "array", "items": {"type": "string"}},
        "publisher_org_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^fmo:org:"}},
        "artifact_class": {"enum": ["model_disclosure", "system_prompt", "behavior_specification", "technical_report", "risk_report", "governance_policy", "legal_terms", "evaluation_methodology", "index", "release_post", "other"]},
        "artifact_class_native": {"type": "string"},
        "native_artifact_type": {"$ref": "urn:fmo:schema:1.0.0:common#/$defs/vocabularyValue"},
        "subject_refs": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["subject_id", "scope_role"],
            "properties": {
              "subject_id": {"$ref": "urn:fmo:schema:1.0.0:common#/$defs/typedId"},
              "scope_role": {"enum": ["primary", "configuration", "checkpoint", "product", "deployment", "prospective_family", "other"]},
              "scope_native": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "observed_time": {"$ref": "urn:fmo:schema:1.0.0:common#/$defs/observationExtent"},
        "scope_temporality": {"enum": ["retrospective", "current", "prospective", "mixed", "unclear"]},
        "prospective_scope_native": {"type": "string"},
        "officiality": {"enum": ["provider_published", "provider_documentation", "authorized_export", "research_publication", "observed", "reconstructed", "alleged", "unknown"]},
        "corpus_partition": {"enum": ["main", "quarantine"]},
        "redistribution_status": {"enum": ["permitted", "restricted", "review_required", "metadata_only", "unknown"]},
        "current_version_ids": {"type": "array", "items": {"type": "string", "pattern": "^fmo:artifact-version:"}}
      },
      "allOf": [
        {"if": {"properties": {"artifact_class": {"const": "other"}}}, "then": {"required": ["artifact_class_native"]}},
        {
          "if": {
            "properties": {
              "subject_refs": {
                "contains": {"properties": {"scope_role": {"const": "other"}}}
              }
            }
          },
          "then": {
            "properties": {
              "subject_refs": {
                "items": {
                  "if": {"properties": {"scope_role": {"const": "other"}}},
                  "then": {"required": ["scope_native"]}
                }
              }
            }
          }
        },
        {"if": {"required": ["scope_temporality"], "properties": {"scope_temporality": {"const": "prospective"}}}, "then": {"required": ["prospective_scope_native"]}}
      ]
    }
  ],
  "unevaluatedProperties": false
}
